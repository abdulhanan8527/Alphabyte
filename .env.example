# ── Alphabyte environment variables ────────────────────────────────
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` to version control.

# Public site URL (used for canonical links, sitemap, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:8090

# Public contact details
NEXT_PUBLIC_WHATSAPP=923000000000
NEXT_PUBLIC_BUSINESS_EMAIL=

# ── Calendly ───────────────────────────────────────────────────────
# Your personal Calendly scheduling URL, e.g. https://calendly.com/alphabyte/30min
NEXT_PUBLIC_CALENDLY_URL=

# ── Resend (transactional email) ───────────────────────────────────
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=
# The "from" address — must be a domain you verified in Resend,
# e.g. Alphabyte <hello@yourdomain.com>
EMAIL_FROM=Alphabyte <onboarding@resend.dev>
# Where enquiry notifications are sent (your inbox). Falls back to EMAIL_FROM.
ENQUIRY_TO_EMAIL=
